#!/usr/bin/env bash
# opencode-pick — launch opencode with a profile selected from
# $SCRIPT_DIR/opencode-models.zsh (override via OPENCODE_PROFILE_FILE)
# without touching global env.
#
# Profile format in that file: blocks separated by blank lines, each starting
# with `# <Name>` header followed by `export ...` or `# export ...` lines.
# Whether lines are commented or not is irrelevant — the picker enables them.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROFILE_FILE="${OPENCODE_PROFILE_FILE:-$SCRIPT_DIR/opencode-models.zsh}"
_NODE_BIN="$(command -v node || true)"
if [[ -z "$_NODE_BIN" ]]; then
  for _node_candidate in \
    "${NVM_BIN:-}/node" \
    "${VOLTA_HOME:-}/bin/node" \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    /usr/bin/node; do
    if [[ -x "$_node_candidate" ]]; then
      _NODE_BIN="$_node_candidate"
      break
    fi
  done
fi

if [[ ! -r "$PROFILE_FILE" ]]; then
  echo "opencode-pick: cannot read $PROFILE_FILE" >&2
  exit 1
fi

# Parse blocks. Emit "NAME<TAB>line1\nline2\n..." per profile.
# Lines are normalized by stripping leading `# ` so commented exports activate.
parse_profiles() {
  awk '
    BEGIN { name=""; buf="" }
    function flush() {
      if (name != "" && buf != "") {
        gsub(/\n+$/, "", buf)
        printf("%s\t%s\037", name, buf)
      }
      name=""; buf=""
    }
    /^[[:space:]]*$/ { flush(); next }
    {
      line=$0
      if (name == "" && line ~ /^#[[:space:]]*[^[:space:]]/) {
        sub(/^#[[:space:]]*/, "", line)
        name=line
        next
      }
      sub(/^#[[:space:]]*/, "", line)
      if (line ~ /^export[[:space:]]+OPENCODE_/) {
        buf = buf line "\n"
      }
    }
    END { flush() }
  ' "$PROFILE_FILE"
}

PROFILES_RAW="$(parse_profiles)"

if [[ -z "$PROFILES_RAW" ]]; then
  echo "opencode-pick: no profiles found in $PROFILE_FILE" >&2
  exit 1
fi

# Build name list (one per line) preserving order.
NAMES="$(printf '%s' "$PROFILES_RAW" | tr '\037' '\n' | awk -F'\t' 'NF>=2 {print $1}')"

usage() {
  cat >&2 <<'EOF'
opencode-pick [--list] [--profile <name>] [-- <opencode args...>]
  No args               : interactive picker (fzf if available, else select)
  --list                : print profile names and exit
  --profile <name>      : skip picker, use named profile
  --                    : everything after is forwarded to opencode
  -h | --help           : this help
EOF
}

PROFILE_ARG=""
FORWARD=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --list)
      printf '%s\n' "$NAMES"
      exit 0
      ;;
    -p|--profile)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      PROFILE_ARG="$2"; shift 2 ;;
    --) shift; FORWARD=("$@"); break ;;
    *) echo "unknown arg: $1 (use -- to forward args to opencode)" >&2; usage; exit 2 ;;
  esac
done

choose() {
  if [[ -n "$PROFILE_ARG" ]]; then
    printf '%s\n' "$PROFILE_ARG"
    return
  fi
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "$NAMES" | fzf --prompt='opencode profile> ' --height=40% --reverse --no-multi
    return
  fi
  PS3=$'\nSelect profile: '
  local IFS=$'\n'
  local arr=( $NAMES )
  select pick in "${arr[@]}"; do
    if [[ -n "${pick:-}" ]]; then printf '%s\n' "$pick"; return; fi
  done
}

CHOICE="$(choose || true)"
if [[ -z "${CHOICE:-}" ]]; then
  echo "opencode-pick: no profile selected" >&2
  exit 130
fi

# Extract chosen block's exports.
BLOCK="$(
  printf '%s' "$PROFILES_RAW" \
    | awk -v target="$CHOICE" 'BEGIN{RS="\037"; FS="\t"} $1==target {print $2}'
)"

if [[ -z "$BLOCK" ]]; then
  echo "opencode-pick: profile '$CHOICE' not found" >&2
  exit 1
fi

# Apply exports in current shell and exec opencode.
echo "→ profile: $CHOICE" >&2
unset OPENCODE_MODEL_PRIMARY OPENCODE_MODEL_CONDUCTOR
unset OPENCODE_MODEL_SUBAGENT_WORKER OPENCODE_MODEL_SUBAGENT_PLANNER OPENCODE_MODEL_SUBAGENT_MINI
unset OPENCODE_REASONING_PRIMARY OPENCODE_REASONING_CONDUCTOR OPENCODE_REASONING_SECONDARY OPENCODE_REASONING_TERTIARY
_PROFILE_VARS=()
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  if [[ "$line" =~ ^export[[:space:]]+(OPENCODE_[A-Z0-9_]+)= ]]; then
    _PROFILE_VARS+=("${BASH_REMATCH[1]}")
  fi
  # shellcheck disable=SC2086
  eval "$line"
done <<< "$BLOCK"

# Show only non-secret model and reasoning settings.
_DIAGNOSTIC_VARS=(
  OPENCODE_MODEL_PRIMARY
  OPENCODE_MODEL_CONDUCTOR
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_PLANNER
  OPENCODE_MODEL_SUBAGENT_MINI
  OPENCODE_MODEL_LEARNING
  OPENCODE_REASONING_PRIMARY
  OPENCODE_REASONING_CONDUCTOR
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_TERTIARY
)
for _diagnostic_var in "${_DIAGNOSTIC_VARS[@]}"; do
  _diagnostic_is_profile_managed=0
  for _profile_var in "${_PROFILE_VARS[@]}"; do
    [[ "$_diagnostic_var" == "$_profile_var" ]] && _diagnostic_is_profile_managed=1
  done
  [[ "$_diagnostic_is_profile_managed" == 1 ]] || continue

  _diagnostic_value="${!_diagnostic_var}"
  [[ "$_diagnostic_value" =~ [[:cntrl:]] ]] && continue
  printf '%s=%s\n' "$_diagnostic_var" "$_diagnostic_value" >&2
done

# ---------------------------------------------------------------------------
# Reasoning overlay — inject reasoningEffort only for models that support it.
# opencode deep-merges OPENCODE_CONFIG_CONTENT on top of the base config, so
# keys present here ADD to agents; absent key = omitted from request entirely.
# Sending "" (unset env via {env:VAR}) causes kimi/openai-compatible providers
# to forward reasoning_effort:"" which those APIs reject.
# Compatible with bash 3.2 (macOS default) — uses parallel indexed arrays.
# ---------------------------------------------------------------------------

# Parallel arrays: agent names and their corresponding tier env-var names.
_RM_AGENTS=(
  conductor
  planner
  architect
  coder
  writer
  code-reviewer
  angular-cop
  dotnet-cop
  gdpr-specialist
  security-reviewer
  tdd-guide
  build-error-resolver
  e2e-runner
  doc-updater
  refactor-cleaner
  database-reviewer
  api-spec-architect
  git-specialist
  scout
  learning-reviewer
  ecosystem-auditor
)
_RM_VARS=(
  OPENCODE_REASONING_CONDUCTOR
  OPENCODE_REASONING_PRIMARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_TERTIARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_SECONDARY
  OPENCODE_REASONING_PRIMARY
  OPENCODE_REASONING_TERTIARY
  OPENCODE_REASONING_TERTIARY
  OPENCODE_REASONING_TERTIARY
  OPENCODE_REASONING_SECONDARY
)

# Which OPENCODE_MODEL_* var each agent actually resolves to in opencode.jsonc.
# NOT the same partition as _RM_VARS above (e.g. PRIMARY-tier agents resolve
# via OPENCODE_MODEL_SUBAGENT_PLANNER, not OPENCODE_MODEL_PRIMARY) — mirrors
# each agent's "model" field in opencode.jsonc 1:1.
_RM_MODEL_VARS=(
  OPENCODE_MODEL_CONDUCTOR
  OPENCODE_MODEL_SUBAGENT_PLANNER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_WORKER
  OPENCODE_MODEL_SUBAGENT_PLANNER
  OPENCODE_MODEL_SUBAGENT_MINI
  OPENCODE_MODEL_SUBAGENT_MINI
  OPENCODE_MODEL_LEARNING
  OPENCODE_MODEL_SUBAGENT_WORKER
)

# Models whose API rejects reasoning_effort:"medium" (only xhigh/high/low are
# valid) — sending "medium" gets the request rejected, same failure class as
# the kimi empty-string bug. Clamp to "high" for these instead of omitting.
_RM_NO_MEDIUM_MODELS=(
  alibabacloud/qwen3.8-max-preview
)

_model_rejects_medium() {
  local _needle="$1" _candidate
  for _candidate in "${_RM_NO_MEDIUM_MODELS[@]}"; do
    [[ "$_needle" == "$_candidate" ]] && return 0
  done
  return 1
}

_OVERLAY_ENTRIES=""   # comma-separated JSON agent entries
_OVERLAY_LOG=""       # log for stderr
_CONDUCTOR_VARIANT=""

for _i in "${!_RM_AGENTS[@]}"; do
  _agent="${_RM_AGENTS[$_i]}"
  _tier_var="${_RM_VARS[$_i]}"
  _model_var="${_RM_MODEL_VARS[$_i]}"
  _val="${!_tier_var:-}"
  if [[ -n "$_val" ]]; then
    if [[ "$_val" == "medium" && -n "$_model_var" ]] && _model_rejects_medium "${!_model_var:-}"; then
      _val="high"
    fi
    [[ "$_agent" == "conductor" ]] && _CONDUCTOR_VARIANT="$_val"
    # Collect raw JSON fragments; values are simple tokens (high/xhigh/low/max/medium),
    # so no JSON escaping is needed.
    _OVERLAY_ENTRIES="${_OVERLAY_ENTRIES}${_OVERLAY_ENTRIES:+,}\"${_agent}\":{\"variant\":\"${_val}\",\"reasoningEffort\":\"${_val}\"}"
    _OVERLAY_LOG="${_OVERLAY_LOG}   ${_agent}=${_val}"$'\n'
  fi
done

_AGENT_OBJ="{${_OVERLAY_ENTRIES}}"
_HAS_AMBIENT_CONFIG=0
[[ -n "${OPENCODE_CONFIG_CONTENT+x}" ]] && _HAS_AMBIENT_CONFIG=1

if [[ "$_HAS_AMBIENT_CONFIG" == 1 || -n "${_OVERLAY_ENTRIES:-}" ]]; then
  if [[ -z "$_NODE_BIN" ]] || ! _MERGED_CONFIG="$(printf '%s' "${OPENCODE_CONFIG_CONTENT-}" | "$_NODE_BIN" -e '
    const { readFileSync } = require("node:fs");
    const hasAmbientConfig = process.argv[1] === "1";
    const overlay = JSON.parse(process.argv[2]);
    const managedAgents = process.argv.slice(3);
    const isObject = (value) =>
      typeof value === "object" && value !== null && !Array.isArray(value);

    try {
      let config = {};
      if (hasAmbientConfig) {
        const parsed = JSON.parse(readFileSync(0, "utf8"));
        if (!isObject(parsed)) throw new Error();
        config = parsed;
      }

      const hadAgents = Object.hasOwn(config, "agent");
      let agents = hadAgents ? config.agent : {};
      if (!isObject(agents)) throw new Error();

      for (const name of managedAgents) {
        if (!Object.hasOwn(agents, name)) continue;
        const current = agents[name];
        if (!isObject(current)) throw new Error();
        const { variant, reasoningEffort, ...preserved } = current;
        agents = { ...agents, [name]: preserved };
      }

      for (const [name, effort] of Object.entries(overlay)) {
        const current = agents[name] ?? {};
        if (!isObject(current) || !isObject(effort)) throw new Error();
        agents = { ...agents, [name]: { ...current, ...effort } };
      }

      if (hadAgents || Object.keys(overlay).length > 0) {
        config = { ...config, agent: agents };
      }
      process.stdout.write(JSON.stringify(config));
    } catch {
      process.exit(1);
    }
  ' "$_HAS_AMBIENT_CONFIG" "$_AGENT_OBJ" "${_RM_AGENTS[@]}")"; then
    echo "opencode-pick: OPENCODE_CONFIG_CONTENT must contain a JSON object" >&2
    exit 1
  fi
  export OPENCODE_CONFIG_CONTENT="$_MERGED_CONFIG"
fi

if [[ -n "${OPENCODE_MODEL_CONDUCTOR:-}" ]]; then
  _STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/opencode"
  _STATE_FILE="$_STATE_DIR/model.json"
  if [[ -n "$_CONDUCTOR_VARIANT" || -e "$_STATE_FILE" ]]; then
    mkdir -p "$_STATE_DIR"
    _STATE_TMP="$(mktemp "$_STATE_DIR/.model.json.tmp.XXXXXX")"
    trap 'rm -f -- "${_STATE_TMP:-}"' EXIT
    if [[ -z "$_NODE_BIN" ]] || ! "$_NODE_BIN" -e '
      const { existsSync, readFileSync, writeFileSync } = require("node:fs");
      const [source, target, model, variant] = process.argv.slice(1);
      const isObject = (value) =>
        typeof value === "object" && value !== null && !Array.isArray(value);

      try {
        let state = {};
        if (existsSync(source)) {
          const parsed = JSON.parse(readFileSync(source, "utf8"));
          if (!isObject(parsed)) throw new Error();
          state = parsed;
        }

        const variants = Object.hasOwn(state, "variant") ? state.variant : {};
        if (!isObject(variants)) throw new Error();
        const updatedVariants = { ...variants };
        if (variant === "") {
          if (!Object.hasOwn(updatedVariants, model)) process.exit(0);
          delete updatedVariants[model];
        } else {
          if (updatedVariants[model] === variant) process.exit(0);
          updatedVariants[model] = variant;
        }
        writeFileSync(target, JSON.stringify({
          ...state,
          variant: updatedVariants,
        }));
      } catch {
        process.exit(1);
      }
    ' "$_STATE_FILE" "$_STATE_TMP" "$OPENCODE_MODEL_CONDUCTOR" "$_CONDUCTOR_VARIANT"; then
      echo "opencode-pick: refusing to replace malformed $_STATE_FILE" >&2
      exit 1
    fi
    if [[ -s "$_STATE_TMP" ]]; then
      mv -f "$_STATE_TMP" "$_STATE_FILE"
    else
      rm -f "$_STATE_TMP"
    fi
    _STATE_TMP=""
    trap - EXIT
  fi
fi

if [[ -n "${_OVERLAY_ENTRIES:-}" ]]; then
  echo "→ reasoning overlay:" >&2
  printf '%s' "${_OVERLAY_LOG}" >&2
fi

unset _i _agent _tier_var _model_var _val _node_candidate _NODE_BIN _profile_var _PROFILE_VARS _diagnostic_var _diagnostic_value _diagnostic_is_profile_managed _DIAGNOSTIC_VARS _OVERLAY_ENTRIES _OVERLAY_LOG _AGENT_OBJ _HAS_AMBIENT_CONFIG _MERGED_CONFIG _CONDUCTOR_VARIANT _STATE_DIR _STATE_FILE _STATE_TMP _RM_AGENTS _RM_VARS _RM_MODEL_VARS _RM_NO_MEDIUM_MODELS
unset -f _model_rejects_medium

exec opencode "${FORWARD[@]+"${FORWARD[@]}"}"
