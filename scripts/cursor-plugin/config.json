{
  "name": "fmflurry-harness",
  "displayName": "fmflurry Harness",
  "description": "Conductor routing, specialist agents, skills, commands, rules and MCP servers from the fmflurry harness.",
  "version": "0.3.0",
  "homepage": "https://github.com/fmflurry/settings-opencode/tree/master/plugins/fmflurry-harness",
  "repository": "https://github.com/fmflurry/settings-opencode",
  "keywords": ["agents", "conductor", "subagents", "skills", "rules", "hooks", "mcp", "code-memory"],
  "category": "developer-tools",
  "tags": ["orchestration", "routing", "workflow"],
  "defaultTierModels": {
    "coding": "grok-4.7-xhigh",
    "smart": "grok-4.7-xhigh",
    "cheap": "grok-4.7-medium"
  },
  "tierFallbacks": {
    "coding": ["grok-4.7-xhigh", "grok-4.6-xhigh", "composer-2.5"],
    "smart": ["grok-4.7-xhigh", "grok-4.6-xhigh", "composer-2.5"],
    "cheap": ["grok-4.7-medium", "grok-4.6-medium", "composer-2.5"]
  },
  "cursorModelFamilies": ["grok-4.7", "grok-4.6", "grok-4.5", "composer-2.5"],
  "agentTiers": {
    "coding": ["coder", "tdd-guide", "build-error-resolver", "refactor-cleaner", "e2e-runner", "api-spec-architect", "gaudi"],
    "smart": ["planner", "architect", "code-reviewer", "security-reviewer", "angular-cop", "dotnet-cop", "database-reviewer", "postgres-dba", "gdpr-specialist", "ecosystem-auditor", "why-synthesizer"],
    "cheap": ["git-specialist", "scout", "writer", "doc-updater", "why-investigator", "comment-judge", "haruspex-commentorum"]
  },
  "rules": {
    "always": [
      "common/agents", "common/autonomy", "common/brief-contract", "common/code-comments", "common/codebase-exploration",
      "common/coding-style", "common/git-workflow", "common/harness-parity", "common/hooks",
      "common/open-pr-check", "common/orchestration", "common/patterns", "common/performance", "common/question-handling",
      "common/security", "common/testing", "common/tool-budget", "common/verification-gate",
      "common/worktree-destruction-safety"
    ],
    "requested": [
      "typescript/coding-style", "typescript/hooks", "typescript/patterns",
      "typescript/security", "typescript/testing"
    ],
    "drop": []
  },
  "hooks": {
    "include": ["pre-tool-use.sh", "rtk-rewrite.sh", "prefer-code-memory.sh", "tool-budget.sh", "stop.sh", "subagent-stop.sh"]
  },
  "cursorHookEvents": [
    "sessionStart", "sessionEnd", "preToolUse", "postToolUse", "postToolUseFailure", "subagentStart", "subagentStop",
    "beforeShellExecution", "afterShellExecution", "beforeMCPExecution", "afterMCPExecution", "beforeReadFile",
    "afterFileEdit", "beforeSubmitPrompt", "preCompact", "stop", "afterAgentResponse", "afterAgentThought",
    "beforeTabFileRead", "afterTabFileEdit", "workspaceOpen"
  ],
  "pluginKeys": [
    "name", "displayName", "description", "version", "minClientVersions", "author", "publisher",
    "homepage", "repository", "license", "logo", "keywords", "category", "tags", "commands",
    "agents", "skills", "rules", "hooks", "variables", "mcpServers"
  ],
  "agentKeys": ["name", "description", "model", "readonly", "is_background", "tier"]
}
